#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Uncomment this block if using RGB
&led_strip {
    chain-length = <6>;
    // chain-length = <35>; // Uncomment if using both per-key and underglow LEDs
    // chain-length = <29>; // Uncomment if using only per-key LEDs.
};
 */

&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
    require-prior-idle-ms = <125>;
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        eaigu {
            bindings = <&kp RA(E)>;
            key-positions = <15 16>;
        };

        egrave {
            bindings = <&egrave>;
            key-positions = <15 14>;
        };

        ecirconflexe {
            bindings = <&ecirconflexe>;
            key-positions = <15 28>;
        };

        agrave {
            bindings = <&agrave>;
            key-positions = <13 14>;
        };

        ccedille {
            bindings = <&kp RA(COMMA)>;
            key-positions = <39 28>;
        };

        ugrave {
            bindings = <&ugrave>;
            key-positions = <19 20>;
        };

        parentheseLEFT {
            bindings = <&kp LPAR>;
            key-positions = <28 27>;
        };

        parentheseRIGHT {
            bindings = <&kp RPAR>;
            key-positions = <31 32>;
        };

        bracketLEFT {
            bindings = <&kp LBKT>;
            key-positions = <27 26>;
        };

        bracketRIGHT {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <32 33>;
        };

        bracesLEFT {
            bindings = <&kp LBRC>;
            key-positions = <26 25>;
        };

        bracesRIGHT {
            bindings = <&kp RBRC>;
            key-positions = <34 33>;
        };

        apos {
            bindings = <&appostrophe>;
            key-positions = <45 46>;
        };

        lshift {
            bindings = <&kp LSHFT>;
            key-positions = <52 40>;
        };

        rshift {
            bindings = <&kp RSHFT>;
            key-positions = <57 45>;
        };

        capsWord {
            bindings = <&caps_word>;
            key-positions = <52 40 57 45>;
        };

        delete {
            bindings = <&kp DEL>;
            key-positions = <57 32>;
        };
    };

    macros {
        ecirconflexe: ecirconflexe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp E>;
            label = "ECIRCONFLEXE";
        };

        egrave: egrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp E>;
            label = "EGRAVE";
        };

        agrave: agrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp A>;
            label = "AGRAVE";
        };

        ugrave: ugrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp U>;
            label = "UGRAVE";
        };

        appostrophe: appostrophe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp APOS &kp SPACE>;
            label = "APPOSTROPHE";
        };
    };

    behaviors {
        testmousescroll: testmousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "TESTMOUSESCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(5)>, <&msc MOVE_Y(-5)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               |CTRL | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   | RALT |

            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3    &kp N4        &kp N5                        &kp N6  &kp N7     &kp N8    &kp N9    &kp N0           &kp GRAVE
&kp TAB    &kp A   &kp Z      &kp E     &kp R         &kp T                         &kp Y   &kp U      &kp I     &kp O     &kp P            &kp MINUS
&kp LCTRL  &kp Q   &kp S      &kp D     &kp F         &kp G                         &kp H   &kp J      &kp K     &kp L     &kp M            &kp SQT
&kp LSHFT  &kp W   &kp X      &kp C     &kp V         &kp B   &kp N1       &kp N2   &kp N   &kp COMMA  &kp DOT   &kp SEMI  &kp EXCLAMATION  &kp RSHFT
                   &kp LCTRL  &kp LALT  &kp LEFT_WIN  &mo 1   &kp SPACE    &kp RET  &mo 2   &kp BSPC   &kp RGUI  &kp RALT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&testmousescroll>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4                    &kp KP_SLASH  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans     &trans
&kp F1      &kp F2            &kp F3             &kp F4             &kp F5        &kp F6                          &kp AMPS      &kp TILDE        &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp F11    &kp F12
&kp GRAVE   &kp EXCL          &kp AT             &kp HASH           &kp DOLLAR    &kp PRCNT                       &kp PRCNT     &kp EQUAL        &kp MINUS        &kp PLUS         &kp ASTRK  &kp TILDE
&trans      &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &trans        &trans        &trans    &trans  &kp PIPE      &kp KP_DOT       &kp KP_NUMBER_0  &kp LBRC         &kp RBRC   &kp PIPE
                              &trans             &trans             &trans        &trans        &trans    &trans  &trans        &trans           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans     &trans  &trans   &trans     &trans    &trans                           &bt BT_SEL 0  &trans     &trans        &bt BT_NXT  &bt BT_PRV  &bt BT_CLR
&kp GRAVE  &none   &kp DQT  &kp CARET  &kp APOS  &kp GRAVE                        &kp N6        &kp N7     &kp N8        &kp N9      &kp N0      &trans
&kp F1     &kp F2  &kp F3   &kp F4     &kp F5    &kp LS(COMMA)                    &kp LS(DOT)   &kp LEFT   &kp DOWN      &kp UP      &kp RIGHT   &trans
&kp F7     &kp F8  &kp F9   &kp N9     &kp F11   &kp F12        &trans    &trans  &kp SLASH     &kp MINUS  &kp QUESTION  &kp COLON   &kp UNDER   &none
                   &trans   &trans     &trans    &trans         &trans    &trans  &trans        &trans     &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans         &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans         &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans         &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp BACKSLASH  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans         &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Layer3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
